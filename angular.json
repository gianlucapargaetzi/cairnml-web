{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "trains-webapp": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "preserveSymlinks": true,
            "outputPath": {
              "base": "build"
            },
            "index": "src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/app/webapp-common/styles/",
                "."
              ],
              "sass": {
                "silenceDeprecations": ["import"]
              }
            },
            "assets": [
              "src/assets",
              "src/favicon.ico",
              "src/env.js",
              "src/404.html",
              "src/manifest.webmanifest",
              "src/app/webapp-common/assets",
              {
                "glob": "**/*",
                "input": "node_modules/ace-builds/src-min",
                "output": "./assets/ace-builds/"
              }
            ],
            "styles": [
              "src/app/webapp-common/assets/fonts/heebo.css",
              "node_modules/ngx-markdown-editor/assets/highlight.js/agate.min.css",
              {
                "bundleName": "global-styles",
                "inject": true,
                "input": "src/app/webapp-common/styles/style.scss"
              }
            ],
            "scripts": [
              "node_modules/ngx-markdown-editor/assets/highlight.js/highlight.min.js"
            ],
            "allowedCommonJsDependencies": [
              "ansi-to-html",
              "has-ansi",
              "fabric/dist/fabric.min",
              "entities",
              "string-to-color",
              "fast-xml-parser",
              "url",
              "@aws-crypto/sha256-browser",
              "@aws-crypto/sha1-browser",
              "@aws-crypto/crc32",
              "@aws-crypto/crc32c",
              "bowser",
              "@smithy/util-defaults-mode-browser",
              "filesize/lib/filesize.es6",
              "hex-rgb",
              "ace-builds",
              "localforage",
              "dom-to-image",
              "hocon-parser",
              "taira",
              "base64",
              "base-64",
              "export-to-csv",
              "dompurify",
              "hammerjs",
              "semver/functions"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                "src/assets",
                "src/app/webapp-common/assets",
                {
                  "glob": "favicon.ico",
                  "input": "src/app/webapp-common/assets/icons/dev-mode",
                  "output": "/assets"
                },
                {
                  "glob": "**/*",
                  "input": "node_modules/ace-builds/src-min",
                  "output": "./assets/ace-builds/"
                },
                "src/version.json",
                "src/configuration.json",
                "src/onboarding.json",
                "src/env.js"
              ]
            },
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                },
                {
                  "replace": "src/app/build-specifics/index.ts",
                  "with": "src/app/build-specifics/index.prod.ts"
                }
              ],
              "serviceWorker": false
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "./proxy.config.mjs",
            "liveReload": false,
            "port": 4300,
            "buildTarget": "trains-webapp:build"
          },
          "configurations": {
            "development": {
              "buildTarget": "trains-webapp:build:development"
            },
            "staging": {
              "buildTarget": "trains-webapp:build:demo"
            },
            "production": {
              "buildTarget": "trains-webapp:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "trains-webapp:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "karmaConfig": "./karma.conf.js",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "./tsconfig.spec.json",
            "include": [
              "src/app/features/dashboard/dashboard.component.spec.ts",
              "src/app/features/experiments/shared/services/clone-naming.service.spec.ts",
              "src/app/features/settings/containers/admin/usage-stats/usage-stats.component.spec.ts",
              "src/app/webapp-common/core/interceptors/webapp-interceptor.spec.ts",
              "src/app/webapp-common/dashboard-search/global-search-dialog/global-search-dialog.component.spec.ts",
              "src/app/webapp-common/dashboard-search/global-search-filter-container/global-search-filter-container.component.spec.ts",
              "src/app/webapp-common/dashboard-search/global-search-filter/global-search-filter.component.spec.ts",
              "src/app/webapp-common/dashboard/containers/dashboard-reports/dashboard-reports.component.spec.ts",
              "src/app/webapp-common/dataset-version/dataset-version-step/dataset-version-step.component.spec.ts",
              "src/app/webapp-common/dataset-version/open-dataset-version-content/open-dataset-version-content.component.spec.ts",
              "src/app/webapp-common/dataset-version/open-dataset-version-details/open-dataset-version-details.component.spec.ts",
              "src/app/webapp-common/dataset-version/open-dataset-version-menu/open-dataset-version-menu.component.spec.ts",
              "src/app/webapp-common/dataset-version/open-dataset-versions/open-dataset-versions.component.spec.ts",
              "src/app/webapp-common/datasets/open-dataset-card/open-dataset-card.component.spec.ts",
              "src/app/webapp-common/experiments-compare/containers/compare-scatter-plot/compare-scatter-plot.component.spec.ts",
              "src/app/webapp-common/experiments/containers/create-experiment-dialog/create-experiment-dialog.component.spec.ts",
              "src/app/webapp-common/experiments/dumb/clear-installed-packges-dialog/clear-installed-packages-dialog.component.spec.ts",
              "src/app/webapp-common/experiments/dumb/experiment-operations-log/experiment-operations-log.component.spec.ts",
              "src/app/webapp-common/layout/header-navbar-tabs/header-navbar-tabs.component.spec.ts",
              "src/app/webapp-common/models/containers/model-info-experiments/model-info-experiments.component.spec.ts",
              "src/app/webapp-common/models/containers/model-info-plots/model-info-plots.component.spec.ts",
              "src/app/webapp-common/models/containers/model-info-scalars/model-info-scalars.component.spec.ts",
              "src/app/webapp-common/pipelines/pipeline-card-menu/pipeline-card-menu.component.spec.ts",
              "src/app/webapp-common/project-info/contribution/contribution-stats.spec.ts",
              "src/app/webapp-common/project-info/overview-panels.spec.ts",
              "src/app/webapp-common/project-workloads/workloads-page/workloads-page.component.spec.ts",
              "src/app/webapp-common/settings/storage-credentials/aws-storage-credentials/aws-storage-credentials.component.spec.ts",
              "src/app/webapp-common/settings/storage-credentials/azure-storage-credentials/azure-storage-credentials.component.spec.ts",
              "src/app/webapp-common/settings/storage-credentials/google-storage-credentials/google-storage-credentials.component.spec.ts",
              "src/app/webapp-common/settings/storage-credentials/storage-credentials.component.spec.ts",
              "src/app/webapp-common/shared/components/charts/donut/donut.component.spec.ts",
              "src/app/webapp-common/shared/components/charts/line-chart/line-chart.component.spec.ts",
              "src/app/webapp-common/shared/components/id-badge/id-badge.component.spec.ts",
              "src/app/webapp-common/shared/components/markdown-editor/markdown-cheat-sheet-dialog/markdown-cheat-sheet-dialog.component.spec.ts",
              "src/app/webapp-common/shared/components/markdown-editor/markdown-editor.component.spec.ts",
              "src/app/webapp-common/shared/components/period-selector/period-selector.component.spec.ts",
              "src/app/webapp-common/shared/components/refresh-button/refresh-button.component.spec.ts",
              "src/app/webapp-common/shared/components/show-only-user-work/show-only-user-work-menu/show-only-user-work-menu.component.spec.ts",
              "src/app/webapp-common/shared/entity-page/entity-delete/common-delete-dialog.component.spec.ts",
              "src/app/webapp-common/shared/pipes/duration.pipe.spec.ts",
              "src/app/webapp-common/shared/pipes/filter-monitor-metric.pipe.spec.ts",
              "src/app/webapp-common/shared/pipes/humanize-result.pipe.spec.ts",
              "src/app/webapp-common/shared/pipes/sort.pipe.spec.ts",
              "src/app/webapp-common/shared/pipes/vulgar-fraction.pipe.spec.ts",
              "src/app/webapp-common/shared/services/login.service.spec.ts",
              "src/app/webapp-common/shared/services/lucene-parser/lucene-parser.service.spec.ts",
              "src/app/webapp-common/shared/services/theme.service.spec.ts",
              "src/app/webapp-common/shared/ui-components/overlay/rename-dialog/rename-dialog.component.spec.ts",
              "src/app/webapp-common/shared/ui-components/panel/project-card/project-card.component.spec.ts",
              "src/app/webapp-common/shared/ui-components/panel/result-line/result-line.component.spec.ts",
              "src/app/webapp-common/shared/ui-components/tags/user-tag/mini-tag/mini-tag.component.spec.ts",
              "src/app/webapp-common/shared/ui-components/tags/user-tag/mini-tags-list/mini-tags-list.component.spec.ts",
              "src/app/webapp-common/tasks/task-folders.utils.spec.ts"
            ],
            "styles": [
              "src/app/webapp-common/styles/style.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "",
                "src/app/webapp-common/styles/"
              ]
            },
            "assets": [
              "src/assets",
              "src/favicon.ico",
              "src/version.json",
              "src/manifest.webmanifest",
              "src/app/webapp-common/assets"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "report-widgets": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "src/app/webapp-common/cairnml-applications/report-widgets",
      "sourceRoot": "src/app/webapp-common/cairnml-applications/report-widgets/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "preserveSymlinks": true,
            "outputPath": {
              "base": "dist/report-widgets"
            },
            "polyfills": [
              "zone.js"
            ],
            "baseHref": "",
            "index": "src/app/webapp-common/cairnml-applications/report-widgets/src/index.html",
            "tsConfig": "src/app/webapp-common/cairnml-applications/report-widgets/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/app/webapp-common/cairnml-applications/report-widgets/src/favicon.ico",
              "src/app/webapp-common/cairnml-applications/report-widgets/src/assets",
              "src/app/webapp-common/cairnml-applications/report-widgets/src/app/webapp-common/assets",
              "src/app/webapp-common/cairnml-applications/report-widgets/src/app/webapp-common/assets/fonts/trains.ttf"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "",
                "src/app/webapp-common/styles/"
              ]
            },
            "styles": [
              "src/app/webapp-common/cairnml-applications/report-widgets/src/app/styles/styles.scss",
              {
                "input": "src/app/webapp-common/assets/fonts/trains-icons.scss",
                "bundleName": "trains-icons",
                "inject": false
              }
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "fast-xml-parser",
              "@aws-crypto/sha1-browser",
              "@aws-crypto/sha256-browser",
              "@aws-crypto/crc32",
              "@aws-crypto/crc32c",
              "bowser",
              "hammerjs",
              "dom-to-image",
              "dompurify",
              "string-to-color",
              "taira",
              "url"
            ],
            "browser": "src/app/webapp-common/cairnml-applications/report-widgets/src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "5kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/webapp-common/cairnml-applications/report-widgets/src/environments/environment.ts",
                  "with": "src/app/webapp-common/cairnml-applications/report-widgets/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "headers": {
                "Content-Security-Policy": "frame-ancestors *"
              },
              "buildTarget": "report-widgets:build:production"
            },
            "development": {
              "buildTarget": "report-widgets:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "report-widgets:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/app/webapp-common/cairnml-applications/report-widgets/src/test.ts",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "src/app/webapp-common/cairnml-applications/report-widgets/tsconfig.spec.json",
            "karmaConfig": "src/app/webapp-common/cairnml-applications/report-widgets/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/app/webapp-common/cairnml-applications/report-widgets/src/favicon.ico",
              "src/app/webapp-common/cairnml-applications/report-widgets/src/assets",
              "src/app/webapp-common/cairnml-applications/report-widgets/src/app/webapp-common/assets"
            ],
            "styles": [
              "src/app/webapp-common/cairnml-applications/report-widgets/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "sm",
      "style": "scss",
      "type": "component"
    },
    "al-schematics:component": {
      "prefix": "sm",
      "styleext": "scss"
    },
    "al-schematics:directive": {
      "prefix": "sm"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "packageManager": "pnpm",
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics",
      "@ngrx/schematics",
      "ngxtension-plugin"
    ]
  }
}
